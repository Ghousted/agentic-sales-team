# Neon serverless Postgres — use the POOLED connection string.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign session cookies (any long random string).
AUTH_SECRET=replace-with-a-long-random-string

# OpenRouter API key (needed for chat and every AI engine). https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: override the model (default google/gemini-2.5-flash).
# OPENROUTER_MODEL=
# Optional: an OpenAI-compatible gateway in front of OpenRouter (default https://openrouter.ai/api/v1).
# OPENROUTER_BASE_URL=
FIRECRAWL_API_KEY=
