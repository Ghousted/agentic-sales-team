# Neon serverless Postgres. Use the POOLED connection string.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign session cookies (any long random string).
AUTH_SECRET=replace-with-a-long-random-string

# OpenRouter API key (needed for chat and every AI engine). https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: override the model (default google/gemini-2.5-flash).
# OPENROUTER_MODEL=

# Firecrawl API key (optional; only the lead-scraping capability needs it). https://firecrawl.dev
FIRECRAWL_API_KEY=

# Secret Vercel Cron sends to /api/cron/jobs (the background job runner).
# Any long random string; the runner refuses every call while it is unset.
CRON_SECRET=
